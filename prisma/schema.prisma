// ─── Phase 9 — Enterprise Fee Architecture (DB-backed) ───────────────
//
// The fee-store has been in-memory + Zustand-persist (localStorage) since
// takeover. These new models make the fee system truly DB-backed and
// multi-tenant-safe, and let the webhook route auto-reconcile instead of
// just logging. All new models are ADDITIVE — the existing Fee + Payment
// models remain untouched so the legacy /api/fees route keeps working.
//
// Architectural mapping (store type → DB row):
//   - school-settings-store.fees.feeHeads[]  → MasterFeeHead
//   - fee-store.FEE_STRUCTURES[]             → FeeStructure (+ FeeHead rows)
//   - fee-store.FeeStructureVersion          → FeeStructureVersion
//   - fee-store.SEED_TRANSACTIONS[]          → FeeTransaction (immutable)
//   - fee-store.settlements[]                → Settlement
//   - fee-store.reconciliations[]            → Reconciliation
//   - fee-store.webhookEvents[]              → WebhookEvent
//
// Settlement status lifecycle:
//   pending → settled → reconciled
//                     ↘ exception → (manual review) → reconciled
//   failure → reversed

/// School-wide master fee-head catalogue — single source of truth for
/// head names, default frequencies, default amounts, categories.
/// Picked from when building per-class fee structures.
model MasterFeeHead {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("Other") // Tuition, Admission, Annual, Transport, Lab, Library, Exam, Activity, Board, Other
  frequency   String   @default("Monthly") // Annual, Half-Yearly, Quarterly, Monthly, Per Term, One-Time
  amount      Float    @default(0)
  mandatory   Boolean  @default(true)
  active      Boolean  @default(true)
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Per-structure line items bound to this catalogue entry (read model).
  structures FeeHead[]

  @@unique([schoolId, name])
}

/// Per-class fee structure — one per (schoolId, classId). The effective
/// structure for a class is the one with status='current'. Drafts and
/// scheduled future structures live alongside as status='draft' or
/// 'scheduled'. Archived structures keep status='archived'.
model FeeStructure {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  className      String
  classLevel     String    @default("Primary") // Pre-Primary, Primary, Middle, Secondary, Senior Secondary
  status         String    @default("draft") // draft, current, scheduled, archived
  version        Int       @default(1)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  publishedAt    DateTime?
  archivedAt     DateTime?
  archivedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  heads        FeeHead[]
  versions     FeeStructureVersion[]
  transactions FeeTransaction[]

  @@unique([schoolId, classId, status])
  @@index([schoolId, status])
}

/// Per-structure line item — snapshot of a master catalogue entry at the
/// time of structure creation. Editing the master catalogue doesn't
/// retroactively change existing structures (versioning integrity).
model FeeHead {
  id          String         @id @default(cuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structureId String
  structure   FeeStructure   @relation(fields: [structureId], references: [id], onDelete: Cascade)
  /// Optional link back to the master catalogue entry. NULL means this
  /// head was custom-typed by the principal and is uncatalogued.
  catalogueId String?
  catalogue   MasterFeeHead? @relation(fields: [catalogueId], references: [id], onDelete: SetNull)
  name        String
  category    String         @default("Other")
  amount      Float          @default(0)
  frequency   String         @default("Monthly")
  mandatory   Boolean        @default(true)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([schoolId, structureId])
  @@index([schoolId, catalogueId])
}

/// Immutable snapshot of a fee structure at the moment it was published.
/// Used for historical audit (a published structure can never be edited —
/// only superseded by a new version that becomes 'current').
model FeeStructureVersion {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structureId String
  structure   FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  version     Int
  /// JSON snapshot of the entire FeeStructureConfig (heads + examFees +
  /// meta) at publish time. Kept as a single JSON column so we don't
  /// need a parallel FeeHeadVersion table.
  snapshot    String
  publishedAt DateTime     @default(now())
  publishedBy String?
  notes       String?

  @@index([schoolId, structureId])
}

/// Immutable financial transaction — every payment event is recorded here
/// for audit + reconciliation. Updates to Fee.paid remain on the legacy
/// Fee model; this table is the source of truth for finance reports.
model FeeTransaction {
  id                   String           @id @default(cuid())
  schoolId             String
  school               School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId            String?
  studentName          String?
  className            String?
  structureId          String?
  structure            FeeStructure?    @relation(fields: [structureId], references: [id], onDelete: SetNull)
  feeHeadName          String?
  amount               Float
  method               String           @default("CASH") // UPI, Card, Net Banking, Cash, Bank Transfer
  status               String           @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED, UNDER_VERIFICATION
  /// Gateway order id (e.g. Razorpay order_id) — used by the webhook
  /// to match the incoming payment.payment_id event back to this row.
  gatewayOrderId       String?          @unique
  gatewayPaymentId     String?
  gatewaySignature     String?
  gatewayName          String? // razorpay, cashfree, payu, manual
  settlementId         String?
  settlement           Settlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  reconciliationStatus String           @default("unreconciled") // unreconciled, reconciled, pending, exception
  reconciliationNote   String?
  reconciledAt         DateTime?
  reconciledBy         String?
  receiptNo            String?
  note                 String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  reconciliations      Reconciliation[]

  @@index([schoolId, status])
  @@index([schoolId, reconciliationStatus])
  @@index([schoolId, createdAt])
}

/// Gateway payout settlement — a batch of transactions the gateway
/// paid out to the school's bank account on a given date.
model Settlement {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payoutId      String?   @unique // gateway payout id (e.g. Razorpay settlement_id)
  gatewayName   String? // razorpay, cashfree, payu, manual
  periodStart   DateTime
  periodEnd     DateTime
  grossAmount   Float
  fees          Float     @default(0)
  netAmount     Float
  status        String    @default("pending") // pending, settled, failed, reversed
  bankReference String?
  paidOutAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions FeeTransaction[]

  @@index([schoolId, status])
  @@index([schoolId, periodStart])
}

/// Reconciliation audit row — matches a FeeTransaction against a
/// Settlement (or against a manual bank statement entry). One row per
/// match attempt (a transaction can be rematched after exceptions).
model Reconciliation {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   FeeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  settlementId  String?
  status        String         @default("pending") // reconciled, unreconciled, pending, exception
  matchedAt     DateTime       @default(now())
  matchedBy     String?
  note          String?

  @@index([schoolId, transactionId])
}

/// Idempotent webhook event log — every incoming webhook is recorded
/// here FIRST, then processed. The unique eventId means a duplicate
/// webhook delivery is a no-op (idempotency).
model WebhookEvent {
  id                   String    @id @default(cuid())
  schoolId             String?
  school               School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  eventId              String    @unique // gateway event_id — used for idempotency
  eventType            String // payment.captured, payment.failed, settlement.processed
  gatewayName          String    @default("razorpay")
  signature            String?
  rawPayload           String // full JSON body
  status               String    @default("received") // received, processing, processed, error, duplicate
  matchedTransactionId String?
  error                String?
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?

  @@index([schoolId, status])
  @@index([eventType])
}
