# pnpm configuration
# Hoist dependencies to node_modules root (needed for Next.js + Prisma + many Radix deps)
shamefully-hoist=true
# Strict peer deps off (Next 16 + React 19 ecosystem)
strict-peer-dependencies=false
# Allow build scripts (Prisma generate, sharp, etc.)
enable-pre-post-scripts=true
# Side-effects cache for faster cold starts
side-effects-cache=true
# Use a single global store
store-dir=/home/z/.pnpm-store
# Lockfile
auto-install-peers=true
